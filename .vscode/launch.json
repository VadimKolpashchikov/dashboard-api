{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "tsx debug",
			"runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
			"console": "integratedTerminal",
			"restart": true,
			"runtimeArgs": [
				"watch",
				"--include",
				"./src/**",
				"--exclude",
				"./src/**/*.spec.ts",
				"--clear-screen=false",
				"${workspaceFolder}/src/main.ts"
			],
			"internalConsoleOptions": "neverOpen",
			"skipFiles": [
				"<node_internals>/**",
				"${workspaceFolder}/node_modules/**",
			],
		}
	]
}