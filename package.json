{
	"name": "dashboard-api",
	"version": "1.0.0",
	"description": "API на NodeJS",
	"homepage": "https://github.com/VadimKolpashchikov/dashboard-api#readme",
	"bugs": {
		"url": "https://github.com/VadimKolpashchikov/dashboard-api/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VadimKolpashchikov/dashboard-api.git"
	},
	"license": "ISC",
	"author": "Vadim Kolpashchikov",
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"dev": "tsx watch --include ./src/** --exclude ./src/**/*.spec.ts --clear-screen=false ./src/main.ts",
		"dev:inspect": "tsx watch --inspect-brk  ./src/main.ts",
		"generate": "prisma generate",
		"lint": "eslint ./src/**",
		"start": "node ./dist/main.js",
		"build": "tsc",
		"test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"bcryptjs": "^3.0.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"express": "^5.2.1",
		"inversify": "^8.2.3",
		"jsonwebtoken": "^9.0.3",
		"reflect-metadata": "^0.2.2",
		"tslog": "^5.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcryptjs": "^2.4.6",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@typescript/native": "npm:typescript@^7.0.2",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.8.0",
		"jest": "^30.4.2",
		"prettier": "^3.9.6",
		"prisma": "^7.9.1",
		"ts-jest": "^29.4.12",
		"tsx": "^4.23.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.65.0"
	}
}
